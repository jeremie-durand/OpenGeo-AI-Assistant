# =============================
# LLM PROVIDER CONFIGURATION
# =============================
# --- OpenAI / Anthropic supported ---
LLM_PROVIDER=openai # or "anthropic"
LLM_API_KEY=sk-...your-api-key... # or "ollama" to use Ollama as a local OpenAI-compatible endpoint
LLM_MODEL=your_model_name # e.g. "claude-3-opus-20240229"
LLM_BASE_URL=https://api.openai.com/v1 # e.g. "http://host.docker.internal:11434/v1" for Ollama or "https://api.anthropic.com/v1" for Anthropic

LLM_MAX_TOKENS=1000  # Maximum tokens in LLM responses. Adjust based on your use case and model limits, geospatial queries regularly need 400-600 tokens to return results.

# =============================
# API AUTHENTICATION
# =============================
# Set ENABLE_AUTH=true and generate a strong API_KEY for production deployments.
# Generate a key: openssl rand -hex 32
ENABLE_AUTH=false
API_KEY=change-me-before-deploying

# =============================
# CLIMATE / WEATHER DATA SOURCE
# =============================
# WEATHER_DATA_SOURCE: which backend to use for climate projections.
#   "planetary_computer"  — NASA NEX-GDDP-CMIP6 via Microsoft Planetary Computer (default).
#                            Requires internet access to planetarycomputer.microsoft.com.
#                            Supports SSP2-4.5 and SSP5-8.5 scenario comparison.
#   "open_meteo"          — Open-Meteo HighResMIP (CMIP6) via climate-api.open-meteo.com.
#                            Free, no API key required for the public tier.
#                            Does NOT support SSP scenario selection.
#                            Supports years 1950-2050 only.
WEATHER_DATA_SOURCE=planetary_computer

# OPEN_METEO_API_KEY: optional commercial API key for Open-Meteo.
# Leave blank to use the free public tier (no key required).
# Get a key at https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# =============================
# SERVICES URLS
# =============================
# --- BACKEND ---
# Base URL of the FastAPI backend. Used by scripts and smoke tests.
BACKEND_URL=http://localhost:8000

# --- FRONTEND ---
# Public URL of the frontend. Used by docker-compose to set CORS_ORIGINS automatically.
# Change this to your production domain when deploying (e.g. https://myapp.example.com).
FRONTEND_URL=http://localhost:3000

# --- CORS ORIGINS ---
# Override the origins the backend will accept (comma-separated).
# Must be explicit origins in production — wildcard disables credentials.
# Set via FRONTEND_URL in docker-compose; override here only if needed.
# CORS_ORIGINS=https://myapp.example.com

# --- STAC API ---
# Base URL of your local/private STAC API (no trailing slash, no path).
# Leave at the default or point to a remote STAC-compliant server.
# Example (Docker Desktop host): STAC_API_URL=http://host.docker.internal:8081
# Example (same docker-compose network): STAC_API_URL=http://stac-api:8081
# Note: the search endpoint is derived as {STAC_API_URL}/search
STAC_API_URL=http://host.docker.internal:8081

# =============================
# RATE LIMITING
# =============================
# Per-IP fixed-window limits (in-memory, resets on restart).
# Uses the `limits` library format: "<count>/<period>" where period is
# second, minute, hour, or day.
RATE_LIMIT_LLM=10/minute
RATE_LIMIT_SEARCH=30/minute

# =============================
# VECTOR SEARCH
# =============================
# Semantic search over STAC collections, used to choose datasets in /api/query
# and by POST /api/datasets/search. Works with no setting at all: the default is
# a built-in Parquet index and the embedding model bundled in the backend image.
# Set to false to turn it off and restore the previous collection selection.
VECTOR_SEARCH_ENABLED=true

# Where the vectors live, chosen by URL scheme:
#   (empty)                         built-in Parquet index in the container
#   file:///data/index.parquet      a local Parquet file
#   s3://bucket/index.parquet       a remote Parquet file (read-only)
#   https://host/index.parquet      a remote Parquet file (read-only)
#   postgresql://user:pass@host/db  PostgreSQL with pgvector and PostGIS
#   mongodb+srv://user:pass@host/db MongoDB $vectorSearch (Atlas or Community 8.2+ with mongot)
#   https://host/search             your own HTTP retriever (query text in, ranked ids out)
VECTOR_SEARCH_URL=

# managed: the assistant builds and refreshes its own index (default).
# external: read-only; the assistant searches documents you maintain.
# The HTTP retriever and remote Parquet files are always external.
VECTOR_SEARCH_MODE=managed

# Timeout in seconds for every vector backend call.
VECTOR_SEARCH_TIMEOUT_SECONDS=5

# Optional backend names (defaults shown).
# VECTOR_SEARCH_TABLE=opengeo.collection_embeddings   # PostgreSQL managed table
# VECTOR_SEARCH_COLLECTION=opengeo_search_collections # MongoDB collection
# VECTOR_SEARCH_MONGO_INDEX=opengeo_vector_index      # MongoDB vector search index
# VECTOR_SEARCH_API_KEY=                              # Bearer token for the HTTP retriever

# S3 credentials for s3:// Parquet files (leave unset for public buckets).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=
# AWS_ENDPOINT_URL=

# How text becomes vectors:
#   local   the bundled multilingual model, no network needed (default)
#   openai  any OpenAI-compatible /embeddings endpoint (OpenAI, Ollama, vLLM...)
#   none    only with the HTTP retriever, which embeds on its side
EMBEDDING_PROVIDER=local
# Required with openai, e.g. text-embedding-3-small. Defaults to the bundled model for local.
# EMBEDDING_MODEL=
# For openai. They default to LLM_BASE_URL / LLM_API_KEY only when LLM_PROVIDER=openai.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
