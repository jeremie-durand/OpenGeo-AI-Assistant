# =============================
# LLM PROVIDER CONFIGURATION
# =============================
# --- OpenAI ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-...your-openai-key...
LLM_MODEL=gpt-4-1106-preview
# Optional for OpenAI-compatible endpoints:
# LLM_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Claude) ---
# To use Claude, comment out OpenAI above and uncomment below:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=...your-anthropic-key...
# LLM_MODEL=claude-3-opus-20240229
# Optional for Anthropic-compatible endpoints:
# LLM_BASE_URL=https://api.anthropic.com/v1

# =============================
# API AUTHENTICATION
# =============================
# Set ENABLE_AUTH=true and generate a strong API_KEY for production deployments.
# Generate a key: openssl rand -hex 32
ENABLE_AUTH=false
API_KEY=change-me-before-deploying

# =============================
# EXTREME WEATHER / CLIMATE DATA SOURCE
# =============================
# WEATHER_DATA_SOURCE: which backend to use for climate projections.
#   "planetary_computer"  — NASA NEX-GDDP-CMIP6 via Microsoft Planetary Computer (default).
#                            Requires internet access to planetarycomputer.microsoft.com.
#                            Supports SSP2-4.5 and SSP5-8.5 scenario comparison.
#   "open_meteo"          — Open-Meteo HighResMIP (CMIP6) via climate-api.open-meteo.com.
#                            Free, no API key required for the public tier.
#                            Does NOT support SSP scenario selection.
#                            Supports years 1950-2050 only.
WEATHER_DATA_SOURCE=planetary_computer

# OPEN_METEO_API_KEY: optional commercial API key for Open-Meteo.
# Leave blank to use the free public tier (no key required).
# Get a key at https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# =============================
# SERVICE URLS
# =============================
# Base URL of the FastAPI backend. Used by scripts and smoke tests.
# Default: http://localhost:8000
BACKEND_URL=http://localhost:8000

# Base URL of your local/private STAC API (no trailing slash, no path).
# All GEOINT agents and the query pipeline read this value.
# Leave at the default or point to a remote STAC-compliant server.
# Example (Docker Desktop host): STAC_API_URL=http://host.docker.internal:8081
# Example (same docker-compose network): STAC_API_URL=http://stac-api:8081
# Note: the search endpoint is derived as {STAC_API_URL}/search
STAC_API_URL=http://host.docker.internal:8081

# =============================
# RATE LIMITING
# =============================
# Per-IP fixed-window limits (in-memory, resets on restart).
# Uses the `limits` library format: "<count>/<period>" where period is
# second, minute, hour, or day.
RATE_LIMIT_LLM=10/minute
RATE_LIMIT_SEARCH=30/minute

# =============================
# FRONTEND
# =============================
# Public URL of the frontend. Used by docker-compose to set CORS_ORIGINS automatically.
# Change this to your production domain when deploying (e.g. https://myapp.example.com).
FRONTEND_URL=http://localhost:3000

# Override the origins the backend will accept (comma-separated).
# Must be explicit origins in production — wildcard disables credentials.
# Set via FRONTEND_URL in docker-compose; override here only if needed.
# CORS_ORIGINS=https://myapp.example.com
