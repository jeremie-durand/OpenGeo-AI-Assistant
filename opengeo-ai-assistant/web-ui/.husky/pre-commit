#!/usr/bin/env bash
#
# Python hooks (ruff, isort, black) — skip gracefully if pre-commit is not installed.
# The review gate is skipped here because it runs unconditionally below.
if command -v pre-commit >/dev/null 2>&1; then
  SKIP="${SKIP:+$SKIP,}review-opengaa-gate" pre-commit run --hook-stage pre-commit
fi
#
# Frontend hooks (prettier via lint-staged)
(cd "$(git rev-parse --show-toplevel)/opengeo-ai-assistant/web-ui" && npx lint-staged)
#
# Review gate: staged changes must match an approved /review-opengaa run
scripts/review-opengaa-stamp.sh check
